    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
