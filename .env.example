# AirSpace environment variables
# IMPORTANT: VITE_ prefixed variables are inlined into the JS bundle at build time.
# Never put secrets, API keys, tokens, or sensitive values in VITE_ variables.
# They will be visible to anyone who views the built source code.

# Set to "true" to activate MSW mock API handlers in development (Phase 10)
# VITE_USE_MOCKS=true

# Set to "true" to simulate a failed reflection response from the mock API (Phase 10)
# VITE_MOCK_REFLECT_FAIL=true
